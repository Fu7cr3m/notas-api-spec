# Supabase local: URL da API de autenticação e chave pública (anon/publishable).
# Obtenha com `npx supabase status` na raiz do repositório. Nunca use service_role.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Base da API de notas; em desenvolvimento o Vite faz proxy de /api para http://127.0.0.1:3000.
VITE_API_BASE_URL=/api
