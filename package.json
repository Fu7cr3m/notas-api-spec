{
  "name": "notas-api",
  "version": "1.0.0",
  "description": "Notes API server backed by Supabase Auth and PostgreSQL",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --env-file-if-exists=.env --test dist/tests/unit/*.test.js dist/tests/contract/*.test.js",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test dist/tests/integration/*.test.js",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "contract:lint": "redocly lint --skip-rule=info-license specs/001-notes-api-baseline/contracts/openapi.yaml"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "@types/node": "24.19.1",
    "supabase": "2.119.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
